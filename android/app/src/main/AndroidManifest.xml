<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      網路只用在「網址預覽」：貼上網址時由原生端抓網頁的標題、說明與縮圖
      （網頁直接 fetch 會被 CORS 擋），見 LinkPreviewer.kt。筆記本身完全離線。
      其他功能不需要權限：
      - 匯入：系統的檔案選擇器，只拿到使用者當下挑的檔案。
      - 匯出：系統的「另存新檔」。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      usesCleartextTraffic：還有少數網站只有 http，不開的話預覽一律失敗。
      WebView 只載入 https 的 appassets，這個設定實際上只影響網址預覽。
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.RoutinaWeave">

        <!--
          家族標記：讓 Routina（Hub）掃得到、列進目錄、並能檢查更新。
          鍵名的定義見 routina repo 的 core/contract/Family.kt。
        -->
        <meta-data
            android:name="com.routina.family.member"
            android:value="true" />
        <meta-data
            android:name="com.routina.family.id"
            android:value="weave" />
        <meta-data
            android:name="com.routina.family.name"
            android:value="Routina Weave" />
        <meta-data
            android:name="com.routina.family.summary"
            android:value="筆記與知識圖譜" />

        <!--
          configChanges 不含 uiMode：切換深淺色時要重建 Activity，視窗底色、系統列
          與 WebView 的 prefers-color-scheme 才會換成新的主題。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
